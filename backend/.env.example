# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# AI Provider Selection Configuration ('groq' for production, 'mock' for testing/dev)
AI_PROVIDER=groq

# Groq LLM Provider Credentials
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Database Configuration
# Format: postgres://username:password@hostname:5432/database_name
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autonomous_ai_creator

# Autonomous Execution Scheduler Configuration (Interval in milliseconds, default 15 mins)
AUTONOMOUS_CYCLE_INTERVAL_MS=900000
