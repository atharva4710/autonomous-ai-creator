# ==============================================================================
# Autonomous AI Creator - Environment Configuration Template
# Copy this file to '.env' and fill in the values for local development.
# ==============================================================================

# --- SERVER CONFIGURATION ---
PORT=5000
HOST=localhost
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here

# --- DATABASE CONFIGURATION ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_ai_creator
# For SQLite fallback, you might use:
# DATABASE_URL=file:./dev.db

# --- AI & LLM PROVIDERS API KEYS ---
# Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Other LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- FRONTEND INTEGRATION ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- LOGGING & MONITORING ---
LOG_LEVEL=info
